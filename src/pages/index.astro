---
import '../styles/global.css';
import PageShell from '../components/PageShell';

// Astro.glob was removed in Astro 6; use import.meta.glob with eager:true.
const mdxModules = import.meta.glob('../content/pages/**/*.mdx', { eager: true }) as Record<
  string,
  { default: any; frontmatter?: Record<string, unknown> }
>;

const allPages = Object.entries(mdxModules).map(([path, mod]) => {
  const id = path.replace('../content/pages/', '').replace(/\.mdx$/, '');
  const modelId = (mod.frontmatter?.modelId as string) ?? undefined;
  return {
    id,
    Content: mod.default,
    modelId,
    simId: modelId ? ((mod.frontmatter?.simId as string) ?? id) : undefined,
    order: (mod.frontmatter?.order as number) ?? Infinity,
    tocName: (mod.frontmatter?.['toc-name'] as string) ?? undefined,
  };
});

// Build folder order map from default.mdx files.
// Key: folder path (e.g. "sim-demo"), value: that folder's order.
const folderOrderMap: Record<string, number> = {};
for (const page of allPages) {
  const parts = page.id.split('/');
  if (parts[parts.length - 1] === 'default') {
    folderOrderMap[parts.slice(0, -1).join('/')] = page.order;
  }
}

function sortKey(page: { id: string; order: number }): [number, number] {
  const parts = page.id.split('/');
  if (parts.length === 1) return [page.order, 0];
  const folderPath = parts.slice(0, -1).join('/');
  const folderOrder = folderOrderMap[folderPath] ?? Infinity;
  const isDefault = parts[parts.length - 1] === 'default';
  return [folderOrder, isDefault ? -Infinity : page.order];
}

const pages = allPages.sort((a, b) => {
  const [aFo, aPo] = sortKey(a);
  const [bFo, bPo] = sortKey(b);
  return aFo !== bFo ? aFo - bFo : aPo - bPo;
});

const pageSimIds: Record<string, string> = Object.fromEntries(
  pages.filter(p => p.simId).map(p => [p.id, p.simId!]),
);

const pageModelIds: Record<string, string> = Object.fromEntries(
  pages.filter(p => p.modelId).map(p => [p.id, p.modelId!]),
);

const pageTocNames: Record<string, string> = Object.fromEntries(
  pages.filter(p => p.tocName).map(p => [p.id, p.tocName!]),
);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Backyard Flyer</title>

    {/*
      Bootstrap hash sync — registers a message listener at HTML parse time so
      we catch the host's initial NAVIGATE_TO_HASH (which is posted on the
      iframe.load event, before React's useEffect has had a chance to run).
      Applies the hash to window.location directly; React's hashchange
      listener picks it up from there.

      Lives in plain JS / inline script so it runs synchronously, before any
      module imports. PageShell still registers its own listener for
      subsequent NAVIGATE_TO_HASH messages — both listeners are idempotent.
    */}
    <script is:inline>
      (function () {
        if (window.parent === window) return;
        var TRUSTED = ['https://mefly.dev', 'https://www.mefly.dev'];
        function isTrusted(origin) {
          return TRUSTED.indexOf(origin) !== -1 || /^https?:\/\/localhost(:\d+)?$/.test(origin);
        }
        window.addEventListener('message', function (e) {
          if (!isTrusted(e.origin || '')) return;
          if (!e.data || e.data.type !== 'NAVIGATE_TO_HASH') return;
          var hash = e.data.hash || '';
          if (!hash) return;
          var next = hash.charAt(0) === '#' ? hash : '#' + hash;
          if (window.location.hash !== next) window.location.hash = next;
        });
      })();
    </script>

    <style>
      html, body { height: 100%; overflow: hidden; }
      #page-store { display: none; }
    </style>
  </head>
  <body>
    <!-- Server-rendered MDX content; React reads via innerHTML -->
    <div id="page-store">
      {pages.map(({ id, simId, modelId, Content }) => (
        <div data-page-id={id} data-sim-id={simId} data-model-id={modelId}>
          <Content />
        </div>
      ))}
    </div>

    <PageShell pageIds={pages.map(p => p.id)} pageSimIds={pageSimIds} pageModelIds={pageModelIds} pageTocNames={pageTocNames} client:only="react" />
  </body>
</html>
